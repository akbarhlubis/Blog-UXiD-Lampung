---
import { withBase } from "../lib/url";

const homeHref = withBase("/");
const eventsHref = withBase("/events");
const blogsHref = withBase("/blogs");
const aboutHref = withBase("/about");
---

<footer class="relative mt-10 overflow-hidden rounded-t-[2rem] border-t border-white/10 bg-slate-950 px-6 py-10 text-white md:px-14">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-10 bg-gradient-to-b from-secondary/20 via-secondary/5 to-transparent"></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div class="space-y-2">
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-secondary">UXiD Lampung</p>
        <h2 class="text-2xl font-black">Komunitas UX di Lampung</h2>
        <p class="max-w-2xl text-sm leading-6 text-white/70">
          Website komunitas, event, dan konten UXiD Lampung. Data event akan mengikuti sumber Google Script saat tersedia.
        </p>
      </div>
      <a
        class="inline-flex w-fit items-center rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
        href={homeHref}
      >
        Kembali ke beranda
      </a>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-white/60 md:flex-row md:items-center md:justify-between">
      <p>&copy; UXiD Lampung, 2026.</p>
      <div class="flex flex-wrap gap-4">
        <a class="hover:text-white" href={eventsHref}>Event</a>
        <a class="hover:text-white" href={blogsHref}>Blog</a>
        <a class="hover:text-white" href={aboutHref}>Tentang Kami</a>
      </div>
    </div>
  </div>
</footer>
