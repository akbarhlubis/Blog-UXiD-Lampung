---
import BaseLayout from "./BaseLayout.astro";
import { slugify, withBase } from "../lib/url";

const { frontmatter } = Astro.props;

const pageTitle = frontmatter.title;
const homeHref = withBase("/");
const blogsHref = withBase("/blogs");
---

<BaseLayout pageTitle={pageTitle}>
  <div class="min-h-screen bg-white px-4 pt-2 dark:bg-slate-800 dark:text-white">
    <div class="mx-auto mt-10 flex w-11/12 flex-row gap-1 overflow-hidden text-xs md:text-base">
      <a href={homeHref} class="hover:text-gray-700">Home</a>
      <span class="mr-1">/</span>
      <a href={blogsHref} class="hover:text-gray-700">Blog</a>
      <span class="mr-1">/</span>
      <span class="h-full truncate text-primary">{frontmatter.title}</span>
    </div>

    <div class="mx-auto mt-5 flex min-h-fit w-11/12 flex-col gap-2 overflow-hidden rounded-lg bg-white shadow-lg dark:bg-gray-800 lg:flex-row">
      <div class="flex w-full items-center justify-center bg-gradient-to-br from-primary/15 via-white to-secondary/30 lg:w-1/2">
        <div class="p-10 text-center text-primary">
          <div class="text-xs uppercase tracking-[0.3em] text-primary/60">UXiD Lampung</div>
          <div class="mt-3 text-2xl font-bold">{frontmatter.title}</div>
        </div>
      </div>
      <div class="flex w-full flex-col px-4 py-5 lg:w-1/2">
        <div class="mt-5 space-y-2">
          <h1 class="text-3xl font-bold">{frontmatter.title}</h1>
          <p>{frontmatter.pubDate}</p>
        </div>
      </div>
    </div>

    <div class="mx-auto flex w-11/12 flex-col gap-5 py-10 lg:flex-row">
      <aside class="h-fit w-full rounded-md bg-primary p-4 text-white shadow-md lg:sticky lg:top-2 lg:w-3/12">
        <div class="text-lg font-bold">Table of Contents</div>
        <ul id="toc" class="list-none text-sm"></ul>
      </aside>

      <article class="prose prose-invert w-full max-w-none prose-headings:text-white prose-p:text-white/85 prose-a:text-secondary">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  import { slugify } from "../lib/url";

  const toc = document.querySelector("#toc");
  const headlines = Array.from(document.querySelectorAll("h2, h3"));

  if (toc instanceof HTMLElement) {
    const usedIds = new Set();

    headlines.forEach((item, index) => {
      const text = item.textContent?.trim() ?? "";
      const baseId = slugify(text) || `section-${index + 1}`;
      const uniqueId = usedIds.has(baseId) ? `${baseId}-${index + 1}` : baseId;

      usedIds.add(uniqueId);
      item.id = uniqueId;
      toc.innerHTML += `<li><a class="hover:text-gray-400" href="#${uniqueId}">${index + 1}. ${text}</a></li>`;
    });
  }
</script>
