---
import BaseLayout from "../layouts/BaseLayout.astro";
import RuntimeEventFeed from "../components/RuntimeEventFeed.astro";
import { normalizeEventFeed } from "../lib/event-feed";

const allPosts = await Astro.glob("./events/*.md");
const fallbackItems = normalizeEventFeed(
	allPosts.map((post) => ({
		...post.frontmatter,
		url: post.url,
	}))
);
const eventsEndpoint = import.meta.env.PUBLIC_GOOGLE_SCRIPT_EVENTS_URL ?? "";

const pageTitle = "Event";
// console.log(allPosts);

---
<BaseLayout pageTitle={pageTitle}>
	<div class="mx-auto min-h-screen max-w-7xl px-4 py-12 md:px-8 lg:px-12">
		<RuntimeEventFeed
			title="Agenda dan kegiatan"
			description="Data event diambil dari Google Script saat halaman dibuka. Jika endpoint belum tersedia, arsip lokal tetap ditampilkan sebagai fallback."
			endpoint={eventsEndpoint}
			fallbackItems={fallbackItems}
		/>
	</div>
</BaseLayout>
